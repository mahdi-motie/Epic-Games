    query getStoreConfig($locale: String!, $sandboxId: String!, $templateId: String) {
  Product {
    sandbox(sandboxId: $sandboxId) {
      configuration(locale: $locale, templateId: $templateId) {
        ... on StoreConfiguration {
          configs {
            banner {
              description
              link {
                src
                title
              }
              title
            }
            developerDisplayName
            effectiveDate
            externalPlatformLaunchOptions {
              geForceNow {
                linkSrc
                type
              }
              xCloud {
                linkSrc
                type
              }
              amazonLuna {
                linkSrc
                type
              }
            }
            gameWebsite
            keyImages {
              type
              url
              alt
            }
            legalText
            pcReleaseDate
            productDisplayName
            privacyLink
            publisherDisplayName
            shortDescription
            socialLinks {
              platform
              url
            }
            supportedAudio
            supportedText
            tags(locale: $locale) {
              id
              name
              groupName
            }
            technicalRequirements {
              macos {
                minimum
                recommended
                title
              }
              windows {
                minimum
                recommended
                title
              }
              android {
                minimum
                recommended
                title
              }
              ios {
                minimum
                recommended
                title
              }
            }
            theme {
              dark {
                accent
                theme
              }
              light {
                accent
                theme
              }
              preferredMode
            }
            loginRequirements
            eulaLink
          }
        }
      }
    }
  }
}
