      records {
        availableDate
        preloadingDate
        catalogItemId
        namespace
        appName
        productId
        sandboxType
        sandboxName
        expirationDate
        recordType
        tags
        acquisitionDate
        playtimeLimitTotal
        dependencies {
          recordType
          catalogItemId
          namespace
          artifactId
