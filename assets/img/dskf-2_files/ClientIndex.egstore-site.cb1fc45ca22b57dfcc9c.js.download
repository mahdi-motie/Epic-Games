            path
          }
          releaseInfo {
            appId
            platform
            compatibleApps
          }
          customAttributes {
            key
            value
          }
          dlcItemList {
            id
          }
          mainGameItem {
            id
          }
        }
      }
      responseMetadata {
        nextCursor
        stateToken
      }
    }
  }
}
