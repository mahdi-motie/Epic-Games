    discoverLayout(locale: $locale, slug: $layoutSlug, layoutType: $layoutType) {
      affiliateId
      modules {
        ... on PageHeader {
          __typename
          eyebrow
          type
          title
          description
          banner {
            src
            altText
          }
        }
        ... on StorefrontBreaker {
          __typename
          type
          title
          titleGroup
          description
          backgroundColors
          layout
          action
          couponSlug
          link {
            src
            linkText
          }
          image {
            src
            alt
          }
          eyebrow
          offer {
            namespace
            id
          }
          videoRecipe
        }
        ... on StorefrontFreeGames {
          __typename
          type
          title
        }
        ... on StorefrontCardGroup {
          __typename
          type
          title
          offerPresentation
          offerType
          titleIcon
          groupStyle
          hideTitle
          cardType
          link {
            src
            linkText
          }
          offers {
            namespace
            id
            offer {
              title
              id
              namespace
              description
              keyImages {
                type
                url
              }
              seller {
                id
                name
              }
              productSlug
              urlSlug
              items {
                id
                namespace
              }
              customAttributes {
                key
                value
              }
              categories {
                path
              }
              catalogNs {
                mappings(pageType: "productHome") {
                  pageSlug
                  pageType
                }
              }
              offerMappings {
                pageSlug
                pageType
              }
              price(country: $country) {
                totalPrice {
                  discountPrice
                  originalPrice
                  voucherDiscount
                  discount
                  fmtPrice(locale: $locale) {
                    originalPrice
                    discountPrice
                    intermediatePrice
                  }
                  currencyCode
                  currencyInfo {
                    decimals
                    symbol
                  }
                  dualPrice
                  dualOriginalPrice
                }
                lineOffers {
                  appliedRules {
                    id
                    endDate
                  }
                }
              }
              releaseDate
              pcReleaseDate
              effectiveDate
              viewableDate
              approximateReleasePlan {
                day
                month
                quarter
                year
                releaseDateType
              }
              prePurchase
              countriesBlacklist
              countriesWhitelist
              developerDisplayName
              publisherDisplayName
              tags {
                id
              }
            }
          }
        }
        ... on StorefrontSubModules {
          __typename
          id
          type
          title
          modules {
            ... on StorefrontCarouselV2 {
              id
              title
              type
              carouselOfferType
              topicId
              tagIdentifier
              slideCount
              slidesRef
              carouselSlides {
                title
                eyebrow
                offer {
                  namespace
                  id
                }
                description
                videoRecipe
                link {
                  src
                  linkText
                }
                image {
                  src
                  altText
                }
                mobileImage {
                  src
                  altText
                }
                thumbnail {
                  src
                  altText
                }
                regionRestrictions {
                  filterType
                  appliedCountries
                }
              }
              topicOffers {
                offerId
                namespace
                rank
              }
              catalogOffers {
                offerId
                namespace
              }
            }
            ... on StorefrontBreaker {
              id
              type
              title
              titleGroup
              description
              backgroundColors
              layout
              action
              couponSlug
              link {
                src
                linkText
              }
              image {
                src
                alt
              }
              regionRestrictions {
                filterType
                appliedCountries
              }
              offer {
                namespace
                id
              }
              videoRecipe
            }
            ... on StorefrontAdvancedBanner {
              __typename
              id
              title
              type
              bannerSize
              eyebrow
              description
              legalSubtext
              gradientExists
              bannerLayout
              ctaOrientation
              secondaryCtaStyle
              mainCtaLink {
                src
                linkText
              }
              secondaryCtaLink {
                src
                linkText
              }
              backgroundImage {
                src
                altText
              }
              mobileImage {
                src
                altText
              }
              logoImage {
                src
                altText
              }
              regionRestrictions {
                filterType
                appliedCountries
              }
              offer {
                namespace
                id
              }
            }
            ... on StorefrontCountdownBanner {
              __typename
              id
              type
              targetDate
              mainCtaLink {
                src
                linkText
              }
              backgroundImage {
                src
                altText
              }
              mobileImage {
                src
                altText
              }
              logoImage {
                src
                altText
              }
              regionRestrictions {
                filterType
                appliedCountries
              }
              accessoriesMobileLeftImage {
                src
                altText
              }
              accessoriesMobileRightImage {
                src
                altText
              }
              accessoriesLeftImage {
                src
                altText
              }
              accessoriesRightImage {
                src
                altText
              }
            }
            ... on StorefrontCardGroup {
              id
              type
              title
              link {
                src
                linkText
              }
              titleIcon
              hideTitle
              groupStyle
              offerType
              offerPresentation
              cardType
              offers {
                namespace
                id
                offer {
                  title
                  id
                  namespace
                  offerType
                  expiryDate
                  status
                  isCodeRedemptionOnly
                  description
                  effectiveDate
                  releaseDate
                  pcReleaseDate
                  approximateReleasePlan {
                    day
                    month
                    quarter
                    year
                    releaseDateType
                  }
                  prePurchase
                  keyImages {
                    type
                    url
                  }
                  seller {
                    id
                    name
                  }
                  productSlug
                  urlSlug
                  items {
                    id
                    namespace
                  }
                  customAttributes {
                    key
                    value
                  }
                  categories {
                    path
                  }
                  catalogNs {
                    mappings(pageType: "productHome") {
                      pageSlug
                      pageType
                    }
                  }
                  offerMappings {
                    pageSlug
                    pageType
                  }
                  price(country: $country) {
                    totalPrice {
                      discountPrice
                      originalPrice
                      voucherDiscount
                      discount
                      fmtPrice(locale: $locale) {
                        originalPrice
                        discountPrice
                        intermediatePrice
                      }
                      currencyCode
                      currencyInfo {
                        decimals
                        symbol
                      }
                      dualPrice
                      dualOriginalPrice
                    }
                    lineOffers {
                      appliedRules {
                        id
                        endDate
                      }
                    }
                  }
                  linkedOfferId
                  linkedOffer {
                    effectiveDate
                    customAttributes {
                      key
                      value
                    }
                  }
                  countriesBlacklist
                  countriesWhitelist
                  developerDisplayName
                  publisherDisplayName
                  tags {
                    id
                  }
                }
              }
            }
            ... on StorefrontBrandedList {
              __typename
              id
              title
              type
              offers {
                namespace
                id
                offer {
                  title
                  id
                  namespace
                  description
                  keyImages {
                    type
                    url
                  }
                  seller {
                    id
                    name
                  }
                  productSlug
                  urlSlug
                  items {
                    id
                    namespace
                  }
                  customAttributes {
                    key
                    value
                  }
                  categories {
                    path
                  }
                  catalogNs {
                    mappings(pageType: "productHome") {
                      pageSlug
                      pageType
                    }
                  }
                  offerMappings {
                    pageSlug
                    pageType
                  }
                  price(country: $country) {
                    totalPrice {
                      discountPrice
                      originalPrice
                      voucherDiscount
                      discount
                      fmtPrice(locale: $locale) {
                        originalPrice
                        discountPrice
                        intermediatePrice
                      }
                      currencyCode
                      currencyInfo {
                        decimals
                        symbol
                      }
                    }
                    lineOffers {
                      appliedRules {
                        id
                        endDate
                      }
                    }
                  }
                  releaseDate
                  pcReleaseDate
                  effectiveDate
                  viewableDate
                  approximateReleasePlan {
                    day
                    month
                    quarter
                    year
                    releaseDateType
                  }
                  prePurchase
                  countriesBlacklist
                  countriesWhitelist
                  developerDisplayName
                  publisherDisplayName
                  tags {
                    id
                  }
                }
              }
              offerCount
              offerType
              topicId
              hideTitle
              cardOrder
              eyebrow
              legalSubtext
              gradientExists
              mainCtaLink {
                linkText
                src
              }
              secondaryCtaLink {
                linkText
                src
              }
              secondaryCtaStyle
              backgroundImage {
                src
                alt
              }
              logoImage {
                src
                alt
              }
              regionRestrictions {
                filterType
                appliedCountries
              }
              offer {
                id
                namespace
              }
              titleLink {
                linkText
                src
              }
            }
          }
        }
        ... on StorefrontFeaturedCarousel {
          __typename
          type
          title
          slides {
            title
            eyebrow
            description
            backgroundColor
            image {
              src
              alt
            }
            mobileImage {
              src
              alt
            }
            link {
              src
              linkText
            }
            videoRecipe
          }
        }
        ... on StorefrontMarkdown {
          __typename
          type
          title
          content
        }
      }
      faq {
        title
        content
      }
      redirect {
        code
        url
      }
    }
  }
}
