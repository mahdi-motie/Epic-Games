    query marketingCMS($locale: String!, $slug: String!) {
  StoreCMSPage {
    __typename
    modules(locale: $locale, slug: $slug) {
      title
      layout {
        section {
          topBanner {
            cta {
              src
              linkText
            }
            subTitle
            ribbonColor
            ribbonText
            link {
              src
              linkText
            }
            logo {
              src
              altText
            }
            title
            backgroundVideo {
              sources {
                src
                type
              }
              loop
              autoplay
              muted
            }
            backgroundImage {
              src
              altText
            }
          }
          infoCards {
            cards {
              title
              subTitle
              image {
                altText
                src
              }
            }
          }
          markdownCards {
            cards {
              title
              content
            }
          }
          interactiveCards {
            cards {
              backgroundImage {
                altText
                src
              }
              backgroundColors
              title
              ctaLink {
                linkText
                src
              }
              ctaImage {
                src
                altText
              }
              isInset
            }
          }
          faq {
            title
            list {
              question
              answer
            }
          }
          storeForm {
            submitText
            subTitle
            link {
              src
              linkText
            }
            title
            formField {
              component
              label
              id
              required
              validation
              maxLength
            }
          }
        }
      }
    }
  }
}
